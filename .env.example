# Concert Playlist Configuration
# Copy this to .env and fill in your values.
# Run `python main.py --setup` for guided setup.

# ── Spotify (required) ──────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Set the Redirect URI to http://127.0.0.1:8080 in your Spotify app settings.
# Note: Spotify no longer allows "localhost" — use the explicit IP 127.0.0.1.
# No client secret needed — this app uses the PKCE auth flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080

# ── Apple Calendar / iCloud (optional) ───────────────────────────────────────
# IMPORTANT: Use an app-specific password, NOT your Apple ID password.
# Generate one at https://appleid.apple.com → Sign-In and Security → App-Specific Passwords
#
# Tip: Ticketmaster, Dice, AXS, and most ticketing services send a calendar
# invite when you buy tickets — accept it and concerts appear automatically.
APPLE_CALENDAR_USERNAME=
APPLE_CALENDAR_APP_PASSWORD=

# ── Google Calendar (optional) ────────────────────────────────────────────────
# No OAuth or Google Cloud project needed — just paste the private ICS URL.
# Find it: Google Calendar → Settings (gear) → [your calendar] → Integrate calendar
#          → "Secret address in iCal format"
GOOGLE_CALENDAR_ICS_URL=

# ── Ticketmaster (optional for prep playlist, required for discovery) ─────────
# Enables opener-act lookup for the prep playlist.
# Required for --discover (local concert discovery).
# Get a free key at https://developer.ticketmaster.com/ (5,000 req/day limit).
TICKETMASTER_API_KEY=

# ── Setlist.fm (optional) ─────────────────────────────────────────────────────
# When set, tracks that artists regularly play live receive a score boost,
# surfacing likely setlist songs over deep cuts.
# Get a free key at https://www.setlist.fm/settings/apps
SETLIST_FM_API_KEY=

# ── Last.fm (optional) ────────────────────────────────────────────────────────
# When set, tracks are scored by global play count popularity (log-normalised).
# This is the dominant signal when available — reflects what listeners actually stream.
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ── Prep playlist (auto-filled by --setup) ───────────────────────────────────
PLAYLIST_ID=
PLAYLIST_NAME=Concert Prep

# ── Discovery playlist (auto-filled on first --discover run) ─────────────────
# Finds upcoming concerts near you and builds a playlist to help you decide
# whether to buy tickets.
DISCOVERY_PLAYLIST_ID=
DISCOVERY_PLAYLIST_NAME=Concert Discoveries

# Location for discovery (optional — IP geolocation is used if not set).
# Set one of these if you want to skip the geolocation prompt or run headless.
DISCOVERY_LOCATION=            # e.g. Madison, WI
DISCOVERY_LAT_LNG=             # e.g. 43.07,-89.40 (takes priority over city)

DISCOVERY_RADIUS_MILES=50      # default: 50
DISCOVERY_WINDOW_DAYS=60       # default: 60
